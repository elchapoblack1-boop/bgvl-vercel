# ─────────────────────────────────────────────────────────────
# DATABASE — Neon (free, no credit card) → https://neon.tech
# 1. Sign up at neon.tech with Google/GitHub (no card needed)
# 2. Create a project → copy the "Connection string"
# 3. Paste it below — it looks like:
#    postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
# EMAIL — Gmail App Password
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a password for "Mail"
# ─────────────────────────────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16_char_app_password

# ─────────────────────────────────────────────────────────────
# JWT SECRET — any long random string (min 32 chars)
# You can generate one at: https://generate-secret.vercel.app/32
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string_min_32_chars

# ─────────────────────────────────────────────────────────────
# WHATSAPP (optional)
# ─────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=+2348000000000

# ─────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT
# Add all the above as Environment Variables in:
# Vercel Dashboard → Your Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────
